# Public site URL (no trailing slash). Used for SEO JSON-LD and Open Graph when set.
VITE_SITE_URL=https://www.lifewaysrehab.com

# Backend API base (include /api if your server mounts routes there)
VITE_API_URL=http://localhost:5000/api
# For mobile testing on the same WiFi, use your PC LAN IP instead of localhost:
# VITE_API_URL=http://192.168.1.10:5000/api
