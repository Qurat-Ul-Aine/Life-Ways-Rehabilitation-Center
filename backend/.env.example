# Database
DATABASE_URL="postgresql://user:PASSWORD@localhost:5432/lifeways_db"

# Authentication
JWT_SECRET="GENERATE_RANDOM_SECRET_HERE_MINIMUM_32_CHARACTERS"
JWT_EXPIRY="7d"

# Email Service (Nodemailer)
# SMTP credentials — the Gmail account used to authenticate with Google's SMTP server.
EMAIL_SERVICE="gmail"
EMAIL_USER="your-official-account@gmail.com"
EMAIL_PASS="YOUR_GOOGLE_APP_PASSWORD"

# Visible sender address shown to recipients (must match EMAIL_USER, or be a verified
# "Send mail as" alias on that Gmail account). If omitted, EMAIL_USER is used.
EMAIL_FROM="your-official-account@gmail.com"
EMAIL_FROM_NAME="Life Ways Rehab"

# File Storage (Cloudinary)
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
CLOUDINARY_NAME="YOUR_CLOUDINARY_CLOUD_NAME"

# Environment
NODE_ENV="development"
PORT="5001"
FRONTEND_URL="http://localhost:8081"
# Public URL used in password-reset emails (must open on mobile). Production example:
# PUBLIC_APP_URL="https://www.lifewaysrehab.com"
# Same-WiFi mobile testing example:
# PUBLIC_APP_URL="http://192.168.1.10:8081"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:8082,http://localhost:3000"
