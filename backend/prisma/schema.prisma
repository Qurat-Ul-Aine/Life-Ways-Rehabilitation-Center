generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model appointments {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id          String?                  @db.Uuid
  doctor_id           String?                  @db.Uuid
  service_id          String?                  @db.Uuid
  therapy_plan_id     String?                  @db.Uuid
  analysis_id         String?                  @db.Uuid
  appointment_date    DateTime?                @db.Date
  appointment_time    DateTime?                @db.Time(6)
  type                appointment_type?
  status              appointment_status?
  notes               String?
  doctors             doctors?                 @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients            patients?                @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rehabilitation_services rehabilitation_services? @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  therapy_plans       therapy_plans?           @relation(fields: [therapy_plan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ai_analysis         ai_analysis?             @relation(fields: [analysis_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  telehealth_sessions telehealth_sessions[]
  therapy_sessions    therapy_sessions[]
  reason           String?
  cancelled_reason String?
  reminder_sent    Boolean              @default(false)

  @@index([status])
  @@index([doctor_id])
  @@index([patient_id])
  @@index([therapy_plan_id])
  @@index([analysis_id])
}

model rehabilitation_services {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String            @unique @db.VarChar(100)
  title           String            @db.VarChar(150)
  description     String?
  is_active       Boolean           @default(true)
  doctor_service  doctor_service[]
  patient_services patient_services[]
  appointments    appointments[]
}

model doctor_service {
  doctor_id  String                  @db.Uuid
  service_id String                  @db.Uuid
  doctors    doctors                 @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rehabilitation_services rehabilitation_services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([doctor_id, service_id])
}

model patient_services {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id  String                  @unique @db.Uuid
  service_id  String                  @db.Uuid
  sub_service String?                 @db.VarChar(150)
  selected_at DateTime?               @default(now()) @db.Timestamp(6)
  patients    patients                @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rehabilitation_services rehabilitation_services @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model doctor_patient {
  doctor_id  String   @db.Uuid
  patient_id String   @db.Uuid
  doctors    doctors  @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients   patients @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([doctor_id, patient_id])
}

model doctor_recommendations {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id     String?     @db.Uuid
  doctor_id      String?     @db.Uuid
  condition_type String?     @db.VarChar(100)
  severity_level risk_level?
  match_score    Decimal?    @db.Decimal(5, 2)
  doctors        doctors?    @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients       patients?   @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model recommendation_log {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id  String       @db.Uuid
  doctor_id   String       @db.Uuid
  analysis_id String?      @db.Uuid
  score       Float
  reason      String
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  doctors     doctors      @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients    patients     @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ai_analysis ai_analysis? @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ai_analysis {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id              String               @db.Uuid
  symptoms                String
  detected_issue          String
  medical_history_summary String?
  assessment_data         Json?
  confidence_score        Float
  selected_doctor_id      String?              @db.Uuid
  created_at              DateTime             @default(now()) @db.Timestamp(6)
  patients                patients             @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selected_doctor         doctors?             @relation("ai_analysis_selected_doctor", fields: [selected_doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation_log      recommendation_log[]
  doctor_match_notes      doctor_match_notes[]
  appointments            appointments[]
}

model doctor_match_notes {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id        String      @db.Uuid
  patient_id       String      @db.Uuid
  analysis_id      String      @db.Uuid
  assessment_notes String?
  treatment_notes  String?
  progress_notes   String?
  updated_at       DateTime    @updatedAt @db.Timestamp(6)
  doctors          doctors     @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients         patients    @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ai_analysis      ai_analysis @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([doctor_id, patient_id, analysis_id])
}

model doctors {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String?                  @unique @db.Uuid
  license_no             String                   @unique @db.VarChar(50)
  experience_years       Int?
  specialization         String?                  @db.VarChar(100)
  qualification          String?                  @db.VarChar(100)
  image_url              String?
  about                  String?
  doctor_role            String?                  @db.VarChar(50)
  availability_schedule  Json?
  availability           availability_status?
  consultation_fee       Decimal?                 @db.Decimal(10, 2)
  rating                 Decimal?                 @db.Decimal(3, 2)
  is_approved            Boolean                  @default(false)
  patients_treated       Int?
  success_rate           Decimal?                 @db.Decimal(5, 2)
  gender                 String?                  @db.VarChar(50)
  appointments           appointments[]
  doctor_patient         doctor_patient[]
  doctor_service         doctor_service[]
  doctor_recommendations doctor_recommendations[]
  recommendation_log     recommendation_log[]
  ai_analysis_selected     ai_analysis[]            @relation("ai_analysis_selected_doctor")
  doctor_match_notes     doctor_match_notes[]
  users                  users?                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feedback               feedback[]
  internees              internees[]
  intern_evaluations     intern_evaluations[]
  therapy_plans          therapy_plans[]
  message_threads        message_threads[]
  prescriptions          prescriptions[]
  screening_tests screening_tests[]
}

model feedback {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id    String?   @db.Uuid
  doctor_id     String?   @db.Uuid
  rating        Int?
  comments      String?
  feedback_date DateTime? @db.Date
  doctors       doctors?  @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients      patients? @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model internee_degrees {
  id             Int        @id @default(autoincrement())
  internee_id    String?    @db.Uuid
  degree_program String?    @db.VarChar(100)
  internees      internees? @relation(fields: [internee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model internee_universities {
  id              Int        @id @default(autoincrement())
  internee_id     String?    @db.Uuid
  university_name String?    @db.VarChar(150)
  internees       internees? @relation(fields: [internee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model internees {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?                 @db.Uuid
  department            String?                 @db.VarChar(100)
  internship_start      DateTime?               @db.Date
  internship_end        DateTime?               @db.Date
  mentor_id             String?                 @db.Uuid
  is_active             Boolean                 @default(true)
  gender                String?                 @db.VarChar(20)
  date_of_birth         DateTime?               @db.Date
  address               String?
  cnic                  String?                 @db.VarChar(20)
  semester              String?                 @db.VarChar(50)
  emergency_contact     String?                 @db.VarChar(150)
  skills                String?
  notes                 String?
  application_status    String?                 @default("ACTIVE") @db.VarChar(30)
  required_hours        Decimal?                @default(480) @db.Decimal(7, 2)
  internee_degrees      internee_degrees[]
  internee_universities internee_universities[]
  intern_audit_logs     intern_audit_logs[]
  intern_training_logs  intern_training_logs[]
  intern_attendance     intern_attendance[]
  intern_evaluations    intern_evaluations[]
  doctors               doctors?                @relation(fields: [mentor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model intern_audit_logs {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id     String?    @db.Uuid
  action        String?    @db.VarChar(50)
  changed_by    String?    @db.Uuid
  timestamp     DateTime?  @default(now()) @db.Timestamp(6)
  previous_data Json?
  new_data      Json?
  internees     internees? @relation(fields: [intern_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model intern_training_logs {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id       String?    @db.Uuid
  hours_worked    Decimal?   @db.Decimal(5, 2)
  tasks_completed String?
  learning_notes  String?
  skills_learned  String?
  challenges      String?
  mentor_remarks  String?
  log_type        String?    @default("daily") @db.VarChar(20)
  status          String?    @default("submitted") @db.VarChar(20)
  log_date        DateTime?  @db.Date
  created_by      String?    @db.Uuid
  reviewed_by     String?    @db.Uuid
  reviewed_at     DateTime?  @db.Timestamp(6)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  updated_at      DateTime?  @db.Timestamp(6)
  internees       internees? @relation(fields: [intern_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model intern_attendance {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id    String?    @db.Uuid
  record_date  DateTime?  @db.Date
  check_in     String?    @db.VarChar(10)
  check_out    String?    @db.VarChar(10)
  hours_worked Decimal?   @db.Decimal(5, 2)
  status       String?    @db.VarChar(20)
  remarks      String?
  created_by   String?    @db.Uuid
  approved_by  String?    @db.Uuid
  approved_at  DateTime?  @db.Timestamp(6)
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  updated_at   DateTime?  @db.Timestamp(6)
  internees    internees? @relation(fields: [intern_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([intern_id, record_date])
}

model intern_evaluations {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id    String?    @db.Uuid
  mentor_id    String?    @db.Uuid
  rating       Int?
  comments     String?
  criteria     Json?
  evaluated_at DateTime?  @default(now()) @db.Timestamp(6)
  created_by   String?    @db.Uuid
  internees    internees? @relation(fields: [intern_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  doctors      doctors?   @relation(fields: [mentor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([intern_id])
}

model notifications {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?            @db.Uuid
  type           notification_type?
  title          String?            @db.VarChar(200)
  message        String?
  status         String?            @db.VarChar(20)
  is_read        Boolean?           @default(false)
  sent_date      DateTime?          @db.Timestamp(6)
  created_at     DateTime?          @default(now()) @db.Timestamp(6)
  recipient_role user_role?
  related_id     String?            @db.Uuid
  failure_reason String?
  users          users?             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([status])
}

model patient_addresses {
  id         Int       @id @default(autoincrement())
  patient_id String?   @db.Uuid
  address    String?
  patients   patients? @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model patient_admissions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id     String?   @db.Uuid
  admission_date DateTime? @db.Date
  discharge_date DateTime? @db.Date
  condition      String?
  patients       patients? @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model patient_medical_history {
  id         Int       @id @default(autoincrement())
  patient_id String?   @db.Uuid
  history    String?
  patients   patients? @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model patient_phones {
  id         Int       @id @default(autoincrement())
  patient_id String?   @db.Uuid
  phone      String?   @db.VarChar(20)
  patients   patients? @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model patients {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String?                   @unique @db.Uuid
  age                     Int?
  gender                  String?                   @db.VarChar(10)
  nationality             String?                   @db.VarChar(50)
  condition               String?                   @db.VarChar(100)
  date_of_birth           DateTime?                 @db.Date
  emergency_contact_name  String?                   @db.VarChar(100)
  emergency_contact_phone String?                   @db.VarChar(20)
  status                  String?                   @db.VarChar(20)
  profile_image_url       String?
  about_me                String?
  allergies               String?
  blood_group             String?                   @db.VarChar(10)
  appointments            appointments[]
  doctor_patient          doctor_patient[]
  patient_services        patient_services[]
  doctor_recommendations  doctor_recommendations[]
  recommendation_log      recommendation_log[]
  ai_analysis             ai_analysis[]
  doctor_match_notes      doctor_match_notes[]
  feedback                feedback[]
  patient_addresses       patient_addresses[]
  patient_admissions      patient_admissions[]
  patient_medical_history patient_medical_history[]
  patient_phones          patient_phones[]
  patient_documents       patient_documents[]
  users                   users?                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports                 reports[]
  screening_tests         screening_tests[]
  therapy_plans           therapy_plans[]
  family_members          family_members[]
  audit_logs              audit_logs[]
  message_threads         message_threads[]
  prescriptions           prescriptions[]
  medication_dose_logs    medication_dose_logs[]
  payments                payments[]
}

model patient_documents {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id    String    @db.Uuid
  category      String    @db.VarChar(50)
  title         String    @db.VarChar(255)
  file_name     String    @db.VarChar(255)
  original_name String    @db.VarChar(255)
  mime_type     String?   @db.VarChar(100)
  file_size     Int?
  uploaded_at   DateTime? @default(now()) @db.Timestamp(6)
  patients      patients  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prescriptions prescriptions[]
}

model reports {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id     String?   @db.Uuid
  generated_by   String?   @db.Uuid
  report_type    String?   @db.VarChar(50)
  report_data    String?
  generated_date DateTime? @db.Timestamp(6)
  users          users?    @relation(fields: [generated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients       patients? @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
model screening_conditions {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                @unique @db.VarChar(50)
  name                 String                @db.VarChar(150)
  description          String?
  icon                 String?               @db.VarChar(50)
  sort_order           Int                   @default(0)
  is_active            Boolean               @default(true)
  risk_threshold_medium Int                  @default(20)
  risk_threshold_high   Int                  @default(40)
  questions            screening_questions[]
  risk_guidance        screening_risk_guidance[]
  screenings           screening_tests[]

  @@index([slug])
  @@index([is_active])
}

model screening_questions {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  condition_id   String                @db.Uuid
  section_title  String?               @db.VarChar(150)
  question_text  String
  question_type  String                @default("single_choice") @db.VarChar(30)
  options        Json
  sort_order     Int                   @default(0)
  is_required    Boolean               @default(true)
  scoring_weight Decimal               @default(1) @db.Decimal(5, 2)
  skip_logic     Json?
  conditions     screening_conditions  @relation(fields: [condition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answers        screening_answers[]
}

model screening_risk_guidance {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  condition_id    String               @db.Uuid
  risk_level      risk_level
  title           String               @db.VarChar(200)
  description     String
  explanation     String?
  recommendations Json
  conditions      screening_conditions @relation(fields: [condition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([condition_id, risk_level])
}

model screening_config {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key   String @unique @db.VarChar(100)
  value Json
}

model screening_tests {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String?              @db.Uuid
  condition_id       String?              @db.Uuid
  test_type          String?              @db.VarChar(50)
  assessment_type    String?              @db.VarChar(20)
  age                Int?
  gender             String?              @db.VarChar(20)
  score              Decimal?             @db.Decimal(5, 2)
  risk_level         risk_level?
  status             String?              @default("completed") @db.VarChar(20)
  explanation        String?
  recommendations    Json?
  assigned_doctor_id String?              @db.Uuid
  flagged            Boolean              @default(false)
  follow_up_date     DateTime?            @db.Date
  test_date          DateTime?            @db.Date
  patients           patients?            @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conditions         screening_conditions? @relation(fields: [condition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigned_doctor    doctors?             @relation(fields: [assigned_doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers            screening_answers[]

  @@index([patient_id])
  @@index([risk_level])
  @@index([condition_id])
  @@index([assigned_doctor_id])
}

model screening_answers {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screening_id String              @db.Uuid
  question_id  String              @db.Uuid
  answer_value String
  score        Decimal?            @db.Decimal(5, 2)
  screenings   screening_tests     @relation(fields: [screening_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions    screening_questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
model telehealth_sessions {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointment_id String?       @db.Uuid
  meeting_link   String?
  start_time     DateTime?     @db.Timestamp(6)
  end_time       DateTime?     @db.Timestamp(6)
  notes          String?
  status         String?      @default("waiting") @db.VarChar(20)
  appointments   appointments? @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model therapy_exercises {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapy_plan_id String?        @db.Uuid
  title           String?        @db.VarChar(150)
  description     String?
  media_url       String?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  therapy_plans   therapy_plans? @relation(fields: [therapy_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model therapy_plan_files {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapy_plan_id String        @db.Uuid
  title           String        @db.VarChar(255)
  file_name       String        @db.VarChar(255)
  original_name   String        @db.VarChar(255)
  mime_type       String?       @db.VarChar(100)
  file_size       Int?
  file_type       String?       @db.VarChar(20)
  uploaded_by     String?       @db.VarChar(150)
  uploaded_at     DateTime?     @default(now()) @db.Timestamp(6)
  therapy_plans   therapy_plans @relation(fields: [therapy_plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([therapy_plan_id, uploaded_at(sort: Desc)])
}

model therapy_plans {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String?             @db.Uuid
  doctor_id          String?             @db.Uuid
  therapy_type       String?             @db.VarChar(100)
  description        String?
  diagnosis          String?
  goals              Json?
  frequency_per_week Int?
  start_date         DateTime?           @db.Date
  end_date           DateTime?           @db.Date
  status             therapy_status?
  therapy_exercises  therapy_exercises[]
  therapy_plan_files therapy_plan_files[]
  appointments       appointments[]
  doctors            doctors?            @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients           patients?           @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  therapy_sessions   therapy_sessions[]
}

model therapy_sessions {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapy_plan_id     String?         @db.Uuid
  appointment_id      String?         @db.Uuid
  session_date        DateTime?       @db.Date
  duration            Int?
  session_type        String?         @db.VarChar(20)
  chief_complaint     String?
  observations        String?
  progress_notes      String?
  exercises_discussed String?
  next_steps          String?
  confidential_notes  String?
  status              session_status?
  outcome             String?         @db.VarChar(50)
  pain_level          Int?
  attendance          String?         @db.VarChar(20)
  mood                String?         @db.VarChar(20)
  reminder_sent       Boolean         @default(false)
  therapy_plans       therapy_plans?  @relation(fields: [therapy_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appointments        appointments?   @relation(fields: [appointment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([appointment_id])
}

model user_phones {
  id      Int     @id @default(autoincrement())
  user_id String? @db.Uuid
  phone   String  @db.VarChar(20)
  users   users?  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                  @db.VarChar(100)
  email                 String                  @unique @db.VarChar(150)
  password              String
  role                  user_role
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  is_active             Boolean                 @default(true)
  avatar_url            String?                 @db.VarChar(500)
  doctors               doctors?
  internees             internees[]
  notifications         notifications[]
  password_reset_tokens password_reset_tokens[]
  patients              patients?
  reports               reports[]
  staff                 staff?
  user_phones           user_phones[]
  family_member         family_members?
  security_questions    user_security_questions[]
  audit_logs            audit_logs[]
  messages              messages[]
  preferences           user_preferences?

  @@index([role])
  @@index([email])
}

model user_preferences {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String   @unique @db.Uuid
  appointment_notifications Boolean @default(true)
  medication_reminders    Boolean  @default(true)
  recovery_notifications  Boolean  @default(true)
  session_notifications   Boolean  @default(true)
  patient_updates         Boolean  @default(true)
  email_notifications     Boolean  @default(true)
  in_app_notifications    Boolean  @default(true)
  doctor_registration_notifications Boolean @default(true)
  patient_registration_notifications Boolean @default(true)
  telehealth_notifications Boolean @default(true)
  profile_visibility      String   @default("care_team") @db.VarChar(30)
  data_sharing            Boolean  @default(true)
  theme                   String   @default("system") @db.VarChar(20)
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamp(6)
  users                   users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_security_questions {
  id           Int       @id @default(autoincrement())
  user_id      String    @db.Uuid
  question_key String    @db.VarChar(100)
  answer_hash  String    @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, question_key])
}

model family_members {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @unique @db.Uuid
  patient_id   String    @db.Uuid
  relationship String?   @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients     patients  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model staff {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?            @unique @db.Uuid
  department       String?            @db.VarChar(100)
  position         String?            @db.VarChar(100)
  joined_at        DateTime?          @db.Date
  phone            String?            @db.VarChar(20)
  status           String?            @default("active") @db.VarChar(20)
  base_salary      Decimal?           @db.Decimal(10, 2)
  currency         String?            @default("PKR") @db.VarChar(10)
  staff_role       String?            @default("staff") @db.VarChar(50)
  shift_type       String?            @db.VarChar(20)
  shift_timing     String?            @db.VarChar(50)
  users            users?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_attendance staff_attendance[]
  staff_tasks      staff_tasks[]
  staff_notes      staff_notes[]
  staff_documents  staff_documents[]
}

model staff_documents {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id      String    @db.Uuid
  category      String    @db.VarChar(50)
  title         String    @db.VarChar(255)
  file_name     String    @db.VarChar(255)
  original_name String    @db.VarChar(255)
  mime_type     String?   @db.VarChar(100)
  file_size     Int?
  uploaded_at   DateTime? @default(now()) @db.Timestamp(6)
  staff         staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([staff_id, uploaded_at(sort: Desc)])
}

model staff_attendance {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id   String    @db.Uuid
  date       DateTime  @db.Date
  status     String    @db.VarChar(20)
  check_in   String?   @db.VarChar(10)
  check_out  String?   @db.VarChar(10)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  staff      staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([staff_id, date])
  @@index([staff_id, date(sort: Desc)])
}

model staff_tasks {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id         String    @db.Uuid
  task_description String
  assigned_by      String    @db.VarChar(100)
  assigned_by_id   String?   @db.Uuid
  status           String    @default("pending") @db.VarChar(20)
  date             DateTime  @default(now()) @db.Timestamp(6)
  staff            staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([staff_id, date(sort: Desc)])
}

model staff_notes {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id      String    @db.Uuid
  note_text     String
  added_by      String    @db.VarChar(100)
  added_by_id   String?   @db.Uuid
  added_by_role String?   @db.VarChar(20)
  date          DateTime  @default(now()) @db.Timestamp(6)
  staff         staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([staff_id, date(sort: Desc)])
}

model audit_logs {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action        String    @db.VarChar(50)
  entity_type   String    @db.VarChar(50)
  entity_id     String?   @db.VarChar(100)
  patient_id    String?   @db.Uuid
  actor_user_id String?   @db.Uuid
  actor_name    String?   @db.VarChar(100)
  actor_role    String?   @db.VarChar(50)
  summary       String?
  metadata      Json?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  patients      patients? @relation(fields: [patient_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users         users?    @relation(fields: [actor_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([patient_id])
  @@index([created_at(sort: Desc)])
}

model password_reset_tokens {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.Uuid
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamp(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model message_threads {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id  String     @db.Uuid
  patient_id String     @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamp(6)
  updated_at DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  doctors    doctors    @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients   patients   @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages   messages[]

  @@unique([doctor_id, patient_id])
  @@index([patient_id])
  @@index([doctor_id])
  @@index([updated_at(sort: Desc)])
}

model messages {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id      String          @db.Uuid
  sender_user_id String          @db.Uuid
  body           String
  read_at        DateTime?       @db.Timestamp(6)
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  message_threads message_threads @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users           @relation(fields: [sender_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([thread_id, created_at])
  @@index([sender_user_id])
}

model prescriptions {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id       String              @db.Uuid
  prescribed_by    String              @db.Uuid
  medication_name  String              @db.VarChar(255)
  dosage           String              @db.VarChar(100)
  frequency        String              @db.VarChar(100)
  duration_days    Int?
  schedule         Json?
  instructions     String?
  notes            String?
  status           prescription_status @default(ACTIVE)
  start_date       DateTime            @db.Date
  end_date         DateTime?           @db.Date
  document_id      String?             @db.Uuid
  is_invalid       Boolean             @default(false)
  deleted_at       DateTime?           @db.Timestamp(6)
  created_at       DateTime            @default(now()) @db.Timestamp(6)
  updated_at       DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  patients         patients            @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  doctors          doctors             @relation(fields: [prescribed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient_documents patient_documents? @relation(fields: [document_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dose_logs        medication_dose_logs[]

  @@index([patient_id, status])
  @@index([prescribed_by])
  @@index([deleted_at])
}

model medication_dose_logs {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescription_id String       @db.Uuid
  patient_id      String       @db.Uuid
  dose_period     dose_period
  log_date        DateTime     @db.Date
  taken_at        DateTime     @default(now()) @db.Timestamp(6)
  prescriptions   prescriptions @relation(fields: [prescription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients        patients     @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([prescription_id, dose_period, log_date])
  @@index([patient_id, log_date])
}

enum appointment_status {
  BOOKED
  CONFIRMED
  CANCELLED
  COMPLETED
  MISSED
}

enum appointment_type {
  ONLINE
  PHYSICAL
}

enum availability_status {
  AVAILABLE
  UNAVAILABLE
}

enum notification_type {
  EMAIL
  WHATSAPP
  SYSTEM
  APPOINTMENT
  PAYMENT
  MILESTONE
}

enum risk_level {
  LOW
  MEDIUM
  HIGH
}

enum session_status {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum therapy_status {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum user_role {
  ADMIN
  DOCTOR
  STAFF
  PATIENT
  FAMILY
  INTERN
}
enum prescription_status {
  ACTIVE
  COMPLETED
  DISCONTINUED
  ON_HOLD
  INVALID
}

enum payment_status {
  PENDING
  SUCCESS
  OVERDUE
}

model payments {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id               String         @db.Uuid
  amount                   Decimal        @db.Decimal(12, 2)
  status                   payment_status @default(PENDING)
  reference_number         String?        @db.VarChar(100)
  due_date                 DateTime?      @db.Date
  reminder_before_due_sent Boolean        @default(false)
  reminder_on_due_sent     Boolean        @default(false)
  invoice_notified         Boolean        @default(false)
  success_notified           Boolean        @default(false)
  overdue_notified           Boolean        @default(false)
  created_at               DateTime       @default(now()) @db.Timestamp(6)
  updated_at               DateTime       @default(now()) @updatedAt @db.Timestamp(6)
  patients                 patients       @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patient_id])
  @@index([status])
  @@index([created_at])
}

enum dose_period {
  MORNING
  AFTERNOON
  NIGHT
}

model hospital_settings {
  id             String    @id @default("default") @db.VarChar(50)
  hospital_name  String    @default("Life Ways Rehab") @db.VarChar(200)
  logo_url       String?   @db.VarChar(500)
  contact_email  String?   @db.VarChar(150)
  contact_phone  String?   @db.VarChar(30)
  address        String?
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  updated_by     String?   @db.Uuid
}

model system_preferences {
  id                           String   @id @default("default") @db.VarChar(50)
  default_appointment_duration Int      @default(30)
  timezone                     String   @default("Asia/Karachi") @db.VarChar(50)
  date_format                  String   @default("dd MMM yyyy") @db.VarChar(30)
  updated_at                   DateTime @default(now()) @updatedAt @db.Timestamp(6)
  updated_by                   String?  @db.Uuid
}